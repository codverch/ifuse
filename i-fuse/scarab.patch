+     if (!reg_file_issue(op)) {
+       exec_stage_reject_op(src_sd, ii, FU_OTHER_UNAVAILABLE);
+       STAT_EVENT(exec->proc_id, FU_STARVED);
+       continue;
+     }
+ 
