+static std::string rfp_sram_config_str(int num_sets, int num_ways, int entry_bytes) {
+  int capacity = num_sets * num_ways * entry_bytes;
+  return std::to_string(capacity) + "," + std::to_string(entry_bytes) + "," + std::to_string(num_ways) +
+         ",1,1,1";
