/* Register File Prefetch (RFP) statistics, included from src/stat_files.def.
 *
 * Several counters are aliases, kept because existing scripts read them:
 *   RFP_ELIGIBLE        = RFP_PREDICTION_MADE / RFP_ALL_LOADS
 *   RFP_ISSUED          = RFP_PREFETCH_INJECTED / RFP_ALL_LOADS
 *   RFP_COVERAGE        = loads served from the PRF / RFP_ALL_LOADS
 *   RFP_PRF_SERVED, RFP_PREFETCH_USEFUL, RFP_USED_NO_DEMAND, and
 *     RFP_NUM_PREFETCHED_LOADS all count loads served from the PRF
 *   RFP_SAVED_CYCLES    = RFP_TOTAL_CYCLES_SAVED
 *   RFP_ON_TIME         = RFP_FULL_MITIGATED / RFP_PREFETCH_INJECTED
 * Do not reorder: the stat files are read by column. */

/* rename and launch */
DEF_STAT(RFP_PREDICTED_AT_RENAME, COUNT, NO_RATIO)
DEF_STAT(RFP_ALL_LOADS, COUNT, NO_RATIO)                         /* on-path loads at rename */
DEF_STAT(RFP_PREDICTION_MADE, COUNT, NO_RATIO)
DEF_STAT(RFP_ELIGIBLE, RATIO, RFP_ALL_LOADS)
DEF_STAT(RFP_RETIRE_LOAD, COUNT, NO_RATIO)                       /* loads that trained the PT */
DEF_STAT(RFP_PT_ALLOC, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_HIT, COUNT, NO_RATIO)
DEF_STAT(RFP_STRIDE_CONFIRM, COUNT, NO_RATIO)
DEF_STAT(RFP_STRIDE_CHANGE, COUNT, NO_RATIO)
DEF_STAT(RFP_STRIDE_OUT_OF_RANGE, COUNT, NO_RATIO)               /* stride wider than --rfp_stride_bits */
DEF_STAT(RFP_PAT_ALLOC, COUNT, NO_RATIO)
DEF_STAT(RFP_PAT_EVICT, COUNT, NO_RATIO)
DEF_STAT(RFP_CONF_INC, COUNT, NO_RATIO)
DEF_STAT(RFP_CONF_RESET_ON_MISPRED, COUNT, NO_RATIO)
DEF_STAT(RFP_STORE_BUFFER_DEFER, COUNT, NO_RATIO)                /* cycles the FIFO head waited on an older store */
DEF_STAT(RFP_PREFETCH_INJECTED, COUNT, NO_RATIO)                 /* requests put in the RFP FIFO */
DEF_STAT(RFP_ISSUED, RATIO, RFP_ALL_LOADS)
DEF_STAT(RFP_ELIGIBLE_NOT_ISSUED, COUNT, NO_RATIO)               /* predicted, but no dest register or FIFO full */
DEF_STAT(RFP_PREFETCH_INFLIGHT, COUNT, NO_RATIO)                 /* always 0: only the unused memory path counts it */
DEF_STAT(RFP_PREFETCH_EXECUTED, COUNT, NO_RATIO)                 /* L1 hits written to the PRF tracker */
DEF_STAT(RFP_DROPPED_SINCE_LOAD_BEAT_PREFETCH, COUNT, NO_RATIO)
DEF_STAT(RFP_PREFETCH_USEFUL, COUNT, NO_RATIO)
DEF_STAT(RFP_SAVED_CYCLES, COUNT, NO_RATIO)
DEF_STAT(RFP_PREDICTION_WRONG, COUNT, NO_RATIO)
DEF_STAT(RFP_PRF_LAUNCH, COUNT, NO_RATIO)
DEF_STAT(RFP_PRF_LAUNCH_NO_DEST, COUNT, NO_RATIO)                /* no integer or vector destination */
DEF_STAT(RFP_PRF_SERVED, COUNT, NO_RATIO)
DEF_STAT(RFP_USED_NO_DEMAND, COUNT, NO_RATIO)
DEF_STAT(RFP_NUM_PREFETCHED_LOADS, COUNT, NO_RATIO)
DEF_STAT(RFP_COVERAGE, RATIO, RFP_ALL_LOADS)
DEF_STAT(RFP_PRF_CLEARED_DUE_TO_MISPRED, COUNT, NO_RATIO)
DEF_STAT(RFP_PRF_CLEARED_DUE_TO_RECOVERY, COUNT, NO_RATIO)
DEF_STAT(RFP_PRF_OWNER_MISMATCH, COUNT, NO_RATIO)                /* stale entry from another dynamic load */
DEF_STAT(RFP_LSQ_FIFO_FULL, COUNT, NO_RATIO)
DEF_STAT(RFP_DROPPED_ON_L1_MISS, COUNT, NO_RATIO)
DEF_STAT(RFP_PARTIAL_MITIGATED, COUNT, NO_RATIO)                 /* served, data still in flight at dispatch */
DEF_STAT(RFP_FULL_MITIGATED, COUNT, NO_RATIO)                    /* served, data ready at dispatch */
DEF_STAT(RFP_ON_TIME, RATIO, RFP_PREFETCH_INJECTED)
DEF_STAT(RFP_DROPPED_MEM_PRESSURE, COUNT, NO_RATIO)              /* always 0: never incremented */

/* cycles saved, relative to a normal L1 hit */
DEF_STAT(RFP_TOTAL_CYCLES_SAVED, COUNT, NO_RATIO)
DEF_STAT(RFP_AVG_LAT_REDUCTION_PER_PREF, RATIO, RFP_USED_NO_DEMAND)
DEF_STAT(RFP_SAVED_CYCLES_FULL, COUNT, NO_RATIO)
DEF_STAT(RFP_SAVED_CYCLES_PARTIAL, COUNT, NO_RATIO)
DEF_STAT(RFP_AVG_LAT_REDUCTION_FULL, RATIO, RFP_FULL_MITIGATED)
DEF_STAT(RFP_AVG_LAT_REDUCTION_PARTIAL, RATIO, RFP_PARTIAL_MITIGATED)
DEF_STAT(RFP_REMAINING_LAT_SERVED, COUNT, NO_RATIO)              /* cycles a served load still waited */

/* prediction accuracy, checked at dispatch */
DEF_STAT(RFP_PRED_RESOLVED, COUNT, NO_RATIO)
DEF_STAT(RFP_PRED_CORRECT, RATIO, RFP_PRED_RESOLVED)             /* exact address match */
DEF_STAT(RFP_PRED_WRONG_LINE, COUNT, NO_RATIO)                   /* right line, wrong offset */
DEF_STAT(RFP_PRED_WRONG_ADDR, COUNT, NO_RATIO)                   /* wrong line */

/* load latency sums over retired loads, split by whether RFP served them */
DEF_STAT(RFP_LD_EXEC_MINUS_FETCH, COUNT, NO_RATIO)
DEF_STAT(RFP_LD_RETIRE_MINUS_FETCH, COUNT, NO_RATIO)
DEF_STAT(RFP_LD_EXEC_TO_DONE, COUNT, NO_RATIO)
DEF_STAT(RFP_LD_EXEC_MINUS_FETCH_SERVED, COUNT, NO_RATIO)
DEF_STAT(RFP_LD_RETIRE_MINUS_FETCH_SERVED, COUNT, NO_RATIO)
DEF_STAT(RFP_LD_EXEC_TO_DONE_SERVED, COUNT, NO_RATIO)
DEF_STAT(RFP_LD_EXEC_MINUS_FETCH_DEMAND, COUNT, NO_RATIO)
DEF_STAT(RFP_LD_RETIRE_MINUS_FETCH_DEMAND, COUNT, NO_RATIO)
DEF_STAT(RFP_LD_EXEC_TO_DONE_DEMAND, COUNT, NO_RATIO)

/* coverage at retire */
DEF_STAT(RFP_RETIRE_PRED, COUNT, NO_RATIO)
DEF_STAT(RFP_RETIRE_COVERED, RATIO, RFP_RETIRE_LOAD)
DEF_STAT(RFP_RETIRE_PRED_CORRECT, COUNT, NO_RATIO)               /* served, or right address but late */
DEF_STAT(RFP_RETIRE_PRED_WRONG, COUNT, NO_RATIO)
