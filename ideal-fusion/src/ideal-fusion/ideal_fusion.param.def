/* Ideal fusion parameters. See ideal-fusion/README.md for the full contract.
 *
 * The first three were in general.param.def on Scarab branch
 * hpca2027-ideal-fusion. Names and defaults are unchanged.
 */

// 0 off, 1 discover pairs (no timing effect), 2 apply logged pairs, 3 measure
// logged pairs without fusing. All passes must use the same trace, ROI, and
// warmup, because pairs are keyed by on-path uop number since simulation start.
DEF_PARAM( ideal_fusion_pass            , IDEAL_FUSION_PASS         , uns    , uns       , 1        ,       )

// Fusion window in on-path uops: both loads must fit in a ROB of this size at
// once, so LOAD2 - LOAD1 < distance. Pass 1 matches within it. Passes 2 and 3
// drop logged pairs at or beyond it.
DEF_PARAM( ideal_fusion_distance        , IDEAL_FUSION_DISTANCE     , uns    , uns       , 512      ,       )

// Pair CSV. Written by pass 1, read by passes 2 and 3.
DEF_PARAM( ideal_fusion_log             , IDEAL_FUSION_LOG          , char*  , string    , "ideal_fusion_candidates.csv", )

// Pass 3 output CSV. Was the IDEAL_FUSION_MEASURE_OUT environment variable.
DEF_PARAM( ideal_fusion_measure_log     , IDEAL_FUSION_MEASURE_LOG  , char*  , string    , "ideal_fusion_measure.csv", )
